{
  "agent_id": "retriever_v0",
  "agent_name": "检索与证据智能体",
  "version": "0.2.0",
  "role": "retriever",
  "domain": "multi_hop_qa",
  "description": "本地确定性 BM25 节点，按依赖顺序串行检索并传递桥接实体，不调用 LLM。有命中仅表示候选证据，语义充分性由 Answer-Validator 判断。",
  "reasoning_method": "rag",
  "knowledge_sources": [
    {
      "source_id": "hotpotqa_fixture",
      "source_type": "hotpotqa_record",
      "path_or_endpoint": "data/hotpotqa/fixture_001.json",
      "description": "V0 使用的单条 HotpotQA 本地记录"
    },
    {
      "source_id": "demo_fixture_002",
      "source_type": "hotpotqa_record",
      "path_or_endpoint": "data/hotpotqa/demo_fixture_002.json",
      "description": "阶段 2 用于测试知识源切换的独立演示材料"
    }
  ],
  "tools": [
    {
      "tool_id": "bm25_retriever",
      "tool_type": "python_fn",
      "description": "基于 BM25 的关键词检索工具，从本地文档集中返回 top-k 段落"
    }
  ],
  "model_config": {
    "model_name": "deepseek-v4.1-flash",
    "temperature": 0.1,
    "max_tokens": 512,
    "system_prompt": "本节点不调用 LLM。检索命中标记 unknown，未命中标记 insufficient；相关性得分仅用于 BM25 排序，不是概率。top_k 由 retrieval_config 配置。"
  },
  "neighbor_agents": [
    {
      "agent_id": "planner_v0",
      "relationship": "upstream",
      "communication": "shared_state",
      "description": "从共享状态读取 Planner 产生的子问题列表和检索策略"
    },
    {
      "agent_id": "answer_validator_v0",
      "relationship": "downstream",
      "communication": "shared_state",
      "description": "将检索到的证据片段写入共享状态，供 Answer-Validator 使用"
    }
  ],
  "input_schema": {
    "sub_questions": {
      "type": "array",
      "description": "来自 Planner 的子问题列表（含关键词和依赖关系）",
      "required": true
    },
    "retrieval_strategy": {
      "type": "string",
      "description": "检索策略：sequential 或 parallel",
      "required": true
    },
    "retrieval_supplement_request": {
      "type": "object",
      "description": "来自 Answer-Validator 的补充检索请求（证据不足时触发）",
      "required": false,
      "properties": {
        "target_sq_id": {
          "type": "string",
          "description": "需要补充检索的子问题 ID"
        },
        "additional_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "retrieval_retry_count": {
      "type": "integer",
      "description": "当前补充检索次数，防止无限循环",
      "required": false,
      "default": 0
    }
  },
  "output_schema": {
    "evidence_chunks": {
      "type": "array",
      "description": "每个子问题对应的证据片段列表",
      "items": {
        "type": "object",
        "properties": {
          "sq_id": {
            "type": "string",
            "description": "对应的子问题编号"
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "证据段落文本"
                },
                "source_title": {
                  "type": "string",
                  "description": "来源文档标题"
                },
                "source_paragraph": {
                  "type": "integer",
                  "description": "段落编号"
                },
                "relevance_score": {
                  "type": "number",
                  "description": "BM25 排序分数，不限于 0-1"
                }
              }
            }
          },
          "sufficiency": {
            "type": "string",
            "enum": [
              "sufficient",
              "insufficient",
              "unknown"
            ],
            "description": "unknown 表示有命中但语义充分性待验证；sufficient 仅兼容历史记录"
          },
          "insufficiency_note": {
            "type": "string",
            "description": "若 insufficient，说明缺少哪方面信息"
          }
        }
      }
    },
    "retrieval_retry_count": {
      "type": "integer",
      "description": "更新后的补充检索次数"
    }
  },
  "failure_handling": {
    "max_retries": 3,
    "on_failure": "answer_validator_v0",
    "fallback_message": "检索失败或超过最大重试次数，将使用已有证据（可能不完整）继续生成答案。"
  },
  "retrieval_config": {
    "top_k": 3
  }
}
